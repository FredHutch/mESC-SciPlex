scale = "none", # No scaling, use raw cell numbers
cluster_cols = FALSE,
cluster_rows = FALSE,
clustering_method = "complete",
color = color_palette,
breaks = breaks,
annotation_legend = TRUE
)
#Save image
ggsave(filename = paste0(dataset_name, ".tiff"), plot = p, width = 8, height = 4, dpi = 300)
}
